# ---------------------------------------------------------------------------
# Vunrablity configuration. Copy to `.env` and edit.
# ---------------------------------------------------------------------------

# Where Ollama is listening.
OLLAMA_HOST=http://127.0.0.1:11434

# Model used for line-by-line auditing + chat. Any code-capable model works.
#   ollama pull qwen2.5-coder:7b
OLLAMA_MODEL=qwen2.5-coder:7b

# Context window handed to the model. Bigger = more lines per pass.
OLLAMA_NUM_CTX=8192

# ---------------------------------------------------------------------------
# Crawler limits (the crawler is a downloader, not an attacker: GET/HEAD only)
# ---------------------------------------------------------------------------
CRAWL_MAX_PAGES=400
CRAWL_MAX_ASSETS=1500
CRAWL_MAX_DEPTH=4
CRAWL_MAX_FILE_MB=8
CRAWL_CONCURRENCY=8
CRAWL_TIMEOUT=20
CRAWL_FOLLOW_SUBDOMAINS=true
CRAWL_RESPECT_ROBOTS=true

# ---------------------------------------------------------------------------
# Sandbox
# ---------------------------------------------------------------------------
# auto = prefer llm-sandbox, fall back to the docker CLI
SANDBOX_BACKEND=auto
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_NETWORK=none
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1.0
SANDBOX_WORKDIR_SIZE=2g
SANDBOX_TIMEOUT=120

# ---------------------------------------------------------------------------
# Analysis
# ---------------------------------------------------------------------------
ANALYSIS_CHUNK_LINES=120
ANALYSIS_CHUNK_OVERLAP=15
ANALYSIS_MAX_FILES=400
AGENT_MAX_STEPS=25

DATA_DIR=./data
HOST=127.0.0.1
PORT=8000
