# ---------------------------------------------------------------------------
# Vunrablity configuration. Copy to `.env` and edit.
# ---------------------------------------------------------------------------

# Where Ollama is listening.
OLLAMA_HOST=http://127.0.0.1:11434

# Model used for line-by-line auditing + chat. Any code-capable model works.
#   ollama pull qwen2.5-coder:3b
OLLAMA_MODEL=qwen2.5-coder:3b

# Context window handed to the model. Bigger = more lines per pass.
OLLAMA_NUM_CTX=8192

# ---------------------------------------------------------------------------
# Crawler limits (the crawler is a downloader, not an attacker: GET/HEAD only)
# ---------------------------------------------------------------------------
CRAWL_MAX_PAGES=5000
CRAWL_MAX_ASSETS=20000
CRAWL_MAX_DEPTH=12
CRAWL_MAX_FILE_MB=32
CRAWL_CONCURRENCY=12
CRAWL_TIMEOUT=20
CRAWL_FOLLOW_SUBDOMAINS=true
CRAWL_RESPECT_ROBOTS=false
# Mirror third-party/CDN bundles too — they run in your users' browsers.
CRAWL_EXTERNAL_ASSETS=true

# ---------------------------------------------------------------------------
# Sandbox
# ---------------------------------------------------------------------------
# auto = Docker when a daemon exists, else the local backend.
# Replit has no daemon: use `local` there (.replit already sets it).
SANDBOX_BACKEND=auto
SANDBOX_IMAGE=python:3.11-slim
# The agent needs the network to clone from GitHub / install packages.
SANDBOX_NETWORK=bridge
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2.0
SANDBOX_WORKDIR_SIZE=2g
SANDBOX_TIMEOUT=300
# Ports the agent may bind for previews you can click through.
SANDBOX_PREVIEW_PORTS=8080,8081,3000,5000

# ---------------------------------------------------------------------------
# Analysis
# ---------------------------------------------------------------------------
ANALYSIS_CHUNK_LINES=120
ANALYSIS_CHUNK_OVERLAP=15
ANALYSIS_MAX_FILES=2000
AGENT_MAX_STEPS=40

DATA_DIR=./data
HOST=127.0.0.1
PORT=8000
